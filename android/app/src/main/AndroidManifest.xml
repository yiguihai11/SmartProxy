<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Shizuku 网络共享(normal 级,声明即自动授予):主进程 CoreTetheringLease.holdTestNetwork
         调 ConnectivityManager.requestNetwork(test network)保活受保护上游,缺它 SecurityException,
         startRouting 直接 -2。 -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- DNS 候选(§6):ConnectivityManager 读当前网络原生 DNS(Wi-Fi/移动数据,跳 VPN)做候选点选,
         getNetworkCapabilities/getLinkProperties 均需它;normal 级声明即授予。 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- API 34+:VpnService 用 specialUse 类型声明(normal 权限,免运行时授权)。
         注意 manifest 的 foregroundServiceType 属性没有 `vpn` flag(AOSP 全版本如此),
         真实 VPN 应用(v2rayNG/WireGuard 等)一律声明 specialUse。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 仅代理(SOCKS5)模式后台连通性(§8):本地 SOCKS 监听后台被 uid 网络策略限制,
         弹系统框请求「忽略电池优化」豁免(Android M+ 系统对话框,免运行时授权)。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 开机自启(§4.3):BOOT_COMPLETED 受保护广播必须声明权限。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android 13+:VPN 保活通知展示需运行时授权(§4.3),启动时申请一次。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 应用内应用选择(§5):API 30+ 枚举全部已装应用必需;个人分发 APK 可接受,
         上 Play 需单独向 Google 申请审批。 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- 悬浮网速计(塞班式角落胶囊):TYPE_APPLICATION_OVERLAY 需要悬浮窗特殊权限,
         运行期经 Settings.ACTION_MANAGE_OVERLAY_PERMISSION 引导用户授予(声明不自动授予)。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 悬浮网速计「前台应用判定」:PACKAGE_USAGE_STATS 是特殊授权(AppOps 校验,声明不自动
         授予),经 Settings.ACTION_USAGE_ACCESS_SETTINGS 引导;未授权则胶囊退回显示流量最大应用。 -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".SmartProxyApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartProxy">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SmartProxy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 应用选择页(§5):App 内启动,不导出。 -->
        <activity
            android:name=".AppSelectionActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartProxy" />

        <!-- 日志查看页(Logcat):App 内启动,不导出。读自身进程日志按 pid 过滤,无需 READ_LOGS。 -->
        <activity
            android:name=".LogcatActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartProxy" />

        <!-- 联网状态页(仅绕过模式 + VPN 运行中):App 内启动,不导出。
             懒采集:onResume 开监控、onPause 关,返回上个页/切后台即停,引擎零开销。 -->
        <activity
            android:name=".NetworkStatusActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartProxy" />

        <!-- 悬浮网速计设置对话框(长按胶囊):全屏透明 + 自绘 scrim,胶囊在其上层实时预览。 -->
        <activity
            android:name=".SpeedMeterSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartProxy.Dialog" />

        <!-- VPN 入口:系统以 BIND_VPN_SERVICE 权限绑定;Android 14+ 用 specialUse 类型
             (manifest 无法声明 `vpn` 类型,见上方权限注释)。
             PROPERTY_SPECIAL_USE_FGS_SUBTYPE 是声明用途所必需的。 -->
        <service
            android:name=".SmartProxyVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
        </service>

        <!-- 开机自启(§4.3):exported=false 仍能收系统广播(BOOT_COMPLETED / 升级重发),
             但对外部 app 关闭。 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 日志分享导出(Logcat 页):FileProvider 只暴露 cacheDir 下 shared_logs 子目录,
             免存储权限;authorities 与 Kotlin 侧 "${packageName}.cache" 一致。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.cache"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Shizuku Binder 发现 Provider -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Shizuku 网络共享同步广播接收器 -->
        <receiver
            android:name=".shizuku.ShizukuRoutingSyncReceiver"
            android:exported="false" />
    </application>

</manifest>
